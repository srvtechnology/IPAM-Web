# --- Database ---
# Local (non-Docker) dev: point at a local MySQL instance.
# Docker Compose: this is overridden by docker-compose.yml's `app.environment.DATABASE_URL`.
DATABASE_URL="mysql://ipam:ipam_dev_password@localhost:3306/ipam_alumni"

# --- Auth secrets ---
# Generate real random values, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ALUMNI_SECRET="replace-with-a-random-64-char-hex-string"
JWT_ADMIN_SECRET="replace-with-a-different-random-64-char-hex-string"
AUDIT_HMAC_SECRET="replace-with-another-random-64-char-hex-string"

NODE_ENV="development"

# Seed demo alumni + demo admin accounts on migrate/start. Set to "false" in real production.
SEED_DEMO_USERS="true"

# --- MySQL container credentials (docker-compose only) ---
MYSQL_PASSWORD="ipam_dev_password"
MYSQL_ROOT_PASSWORD="root_dev_password"

# --- Stripe Payment Gateway (optional; test sandbox active if unset) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email SMTP Configuration (Gmail) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="growpos.official@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM_NAME="IPAM Alumni Association"
SMTP_FROM_EMAIL="growpos.official@gmail.com"

# --- Twilio SMS Configuration ---
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_MESSAGING_SERVICE_SID="your-messaging-service-sid"
ACC_SID_TWILIO="your-twilio-account-sid"
AUTH_TOKEN_TWILIO="your-twilio-auth-token"
MSG_SERVICESID="your-messaging-service-sid"

# --- Firebase Client & Web Push Notifications ---
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyBiLw4ytLwtNmhjhDixxd2yGq8qo5UAf0I"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="auratrade-p93c.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="auratrade-p93c"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="auratrade-p93c.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="570831339769"
NEXT_PUBLIC_FIREBASE_APP_ID="1:570831339769:web:594df89ce062124522e228"

